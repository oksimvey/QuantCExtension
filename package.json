{
  "name": "qc-language",
  "displayName": "QC Language Support",
  "description": "Syntax highlighting, semantic diagnostics and language tooling for QuantC",
  "version": "0.2.0",
  "icon": "icons/quantc-icon.svg",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:qc",
    "onCommand:qc.compileAndRun"
  ],
  "main": "./dist/Main.js",
  "contributes": {
    "languages": [
      {
        "id": "qc",
        "aliases": [
          "QuantC",
          "QC",
          "qc"
        ],
        "extensions": [
          ".qc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/quantc-icon.svg",
          "dark": "./icons/quantc-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "qc",
        "scopeName": "source.qc",
        "path": "./syntaxes/qc-tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "qc.compileAndRun",
        "title": "QC: Compile and Run",
        "category": "QC"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "quantcType",
        "description": "A user-defined QuantC type"
      },
      {
        "id": "quantcMember",
        "description": "A resolved QuantC class field or method access"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "qc",
        "scopes": {
          "quantcType": [
            "support.type.primitive.qc"
          ],
          "quantcMember": [
            "entity.name.function.call.qc"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[qc]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oksimvey/QuantCExtension.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/oksimvey/QuantCExtension/issues"
  },
  "homepage": "https://github.com/oksimvey/QuantCExtension#readme",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "typescript": "^6.0.3"
  }
}
